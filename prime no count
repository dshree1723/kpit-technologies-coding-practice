import java.util.*;
public class Main{
    public static void main(String[] args){
        Scanner sc=new Scanner(System.in);
        int a=sc.nextInt();
        int b=sc.nextInt();
        int count=0;
        for(int i=a;i<b;i++){
        if(i<2)
            continue;
            boolean prime=true;
        for(int j=2;j<i/2;j++){
            if(i%j==0){
                prime=false;
                break;
            }
        }
        if(prime)
            count++;
        }
        System.out.println(count);
    }
}
